# Copia este archivo como .env y llena los valores. .env nunca se sube a git.

# --- Inferencia (kilopass, API compatible con OpenAI por confirmar) ---
KILOPASS_API_KEY=
KILOPASS_BASE_URL=
KILOPASS_MODEL=
# Opcional: modelo de embeddings si kilopass lo ofrece; vacío = embeddings locales
KILOPASS_EMBEDDING_MODEL=

# --- MySQL (clúster aparte, temporal) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# Ruta al certificado CA si el clúster exige SSL
MYSQL_SSL_CA=

# --- App ---
# Clave para firmar las sesiones; genera una con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Carpeta donde Chroma guarda los índices de conocimiento
CHROMA_PATH=./data/chroma
